# ==========================================
# Production .gitignore for Next.js Frontend
# ==========================================

# Dependencies
node_modules/
.pnpm-store/

# Next.js Build & Production Outputs
.next/
out/
build/
dist/
.turbo/
.vercel/

# Environment & Secrets (NEVER COMMIT SENSITIVE DATA)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
!.env.example

# TypeScript Compilation Outputs
*.tsbuildinfo
next-env.d.ts.bak

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Test & Coverage
coverage/
.nyc_output/
.jest/
junit.xml
cypress/videos/
cypress/screenshots/
playwright-report/
test-results/

# IDEs & Editor Files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Caches & Temporary Files
.cache/
.eslintcache
.prettiercache
.stylelintcache
tmp/
temp/
scratch/